<Project>
  <!-- The style gate every C# repo carries. TargetFramework stays in each csproj. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- The version agents quote: 0.1.0+<7-char commit sha>, or 0.1.0 alone outside a git checkout. -->
  <PropertyGroup>
    <VersionPrefix>0.5.1</VersionPrefix>
  </PropertyGroup>

  <!--
    The SDK's SourceLink sets SourceRevisionId to the full commit sha in _InitializeSourceControlInformationFromSourceControlManager
    (BeforeTargets InitializeSourceControlInformation), and AddSourceRevisionToInformationalVersion, which depends on
    InitializeSourceControlInformation, appends it to InformationalVersion; this cuts it to 7 characters in between.
  -->
  <Target
    Name="ShortenSourceRevisionId"
    DependsOnTargets="InitializeSourceControlInformation"
    BeforeTargets="AddSourceRevisionToInformationalVersion"
    Condition="'$(SourceControlInformationFeatureSupported)' == 'true'"
  >
    <PropertyGroup Condition="$(SourceRevisionId.Length) &gt; 7">
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Code-quality (CA) analyzers, taken from the first commit. -->
  <PropertyGroup>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- CA1502's threshold is read from this file only; an .editorconfig key for it is not read by the analyzer. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>
</Project>
