<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>godot-mcp</AssemblyName>
    <RootNamespace>GodotMcp.Server</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <!-- The bridge ships beside the published exe; a dev build finds the checkout's bridge/ instead. -->
  <ItemGroup>
    <Content Include="..\..\bridge\**\*.gd" LinkBase="bridge" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GodotMcp.Tests" />
    <InternalsVisibleTo Include="GodotMcp.IntegrationTests" />
  </ItemGroup>
</Project>
