<Project Sdk="Microsoft.NET.Sdk">
  <!-- The capture helper the server starts for a real-time recording: its own process, so a D3D or WinRT fault never
       takes the MCP server down. The Windows SDK projections for Windows.Graphics.Capture come with this target
       framework; the 26100 projection is needed at compile time for GraphicsCaptureSession.IsBorderRequired (a 20348
       API). Its minimum is Windows 10 2004 (10.0.19041, SupportedOSPlatformVersion below), the build that introduced
       IsCursorCaptureEnabled; it checks the OS version before touching a newer member. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>godot-mcp-capture</AssemblyName>
    <RootNamespace>GodotMcp.Capture</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- LibraryImport's generated P/Invoke stub is unsafe code (StandardOutput.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vortice wraps the D3D11 device, the staging texture and the map/unmap that read a captured frame back to the CPU;
         the alternative is hand-written COM vtable calls for five interfaces. SharpDX, the older wrapper, is unmaintained. -->
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
</Project>
