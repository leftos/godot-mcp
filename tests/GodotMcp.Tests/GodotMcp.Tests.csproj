<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>GodotMcp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GodotMcp.Dotnet.Core\GodotMcp.Dotnet.Core.csproj" />
    <ProjectReference Include="..\..\src\GodotMcp.Server\GodotMcp.Server.csproj" />
    <ProjectReference Include="..\GodotMcp.TestSupport\GodotMcp.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The capture helper targets a Windows TFM this project cannot reference, so its pure argument, crop and audio pipe
       files are compiled in here instead; they use nothing of WinRT, Vortice or WASAPI. -->
  <ItemGroup>
    <Compile Include="..\..\src\GodotMcp.Capture\AudioActivationException.cs" Link="Capture\AudioActivationException.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\AudioPipe.cs" Link="Capture\AudioPipe.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\AudioPipeException.cs" Link="Capture\AudioPipeException.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\CaptureArgs.cs" Link="Capture\CaptureArgs.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\CaptureEnd.cs" Link="Capture\CaptureEnd.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\CaptureExit.cs" Link="Capture\CaptureExit.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\Crop.cs" Link="Capture\Crop.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\Deadline.cs" Link="Capture\Deadline.cs" />
    <Compile Include="..\..\src\GodotMcp.Capture\PixelRect.cs" Link="Capture\PixelRect.cs" />
  </ItemGroup>
</Project>
