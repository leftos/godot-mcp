; Engine configuration file.
; The bridge's headless GDScript unit tests: `pwsh run.ps1 gdtest` runs run_tests.gd in this project.

config_version=5

[application]

config/name="godot-mcp bridge tests"
config/features=PackedStringArray("4.7")

[threading]

; Matches CI's 4-core runner, so a test that depends on the pool's size fails here too.
worker_pool/max_threads=4
